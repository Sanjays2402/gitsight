{
  "name": "gitsight-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GitSight standalone web frontend — renders gitsight's git visualizations in a normal browser, reusing the extension's shared renderer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs src/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
