{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-test",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "test/**/*",
    "src/git/format.ts",
    "src/git/hostDetect.ts",
    "src/git/workingTreeStatus.ts",
    "src/git/recentFiles.ts",
    "src/git/coAuthors.ts",
    "src/git/gitignoreInsight.ts",
    "src/git/fileStats.ts",
    "src/git/rangeAuthors.ts",
    "src/git/branchCleanup.ts",
    "src/git/commitLint.ts",
    "src/git/restorePick.ts",
    "src/git/branchAge.ts",
    "src/git/rebaseState.ts",
    "src/git/tagSort.ts",
    "src/git/coAuthorSuggest.ts",
    "src/git/branchCompare.ts",
    "src/git/conventionalCommit.ts",
    "src/git/stashSort.ts",
    "src/git/conflictMarkers.ts",
    "src/git/recentBranches.ts",
    "src/git/latestTag.ts",
    "src/git/pendingPush.ts"
  ],
  "exclude": ["node_modules", "out", "out-test"]
}
