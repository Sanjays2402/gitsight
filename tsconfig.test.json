{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-test",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "test/**/*",
    "src/git/format.ts",
    "src/git/hostDetect.ts",
    "src/git/workingTreeStatus.ts",
    "src/git/recentFiles.ts",
    "src/git/coAuthors.ts"
  ],
  "exclude": ["node_modules", "out", "out-test"]
}
